# --- Connection -------------------------------------------------------------
# Camera IP address on the local network
TAPO_IP=192.168.1.4

# ONVIF port (default for Tapo C500: 2020)
TAPO_PORT=2020

# --- Authentication ---------------------------------------------------------
# Camera Account username (Tapo app > Advanced Settings > Camera Account)
TAPO_USER=admin

# Camera Account password (required)
TAPO_PASS=your_password_here

# --- Movement behavior ------------------------------------------------------
# Short step intensity for tap moves (0.0 to 1.0)
TAPO_STEP=0.1

# Extra multiplier for vertical tap moves
TAPO_VERTICAL_STEP_MULTIPLIER=1.5

# Continuous move speed used by CLI, extreme moves, and patrol sweeps (0.0 to 1.0)
TAPO_SPEED=0.5

# Patrol smoothness: lower segment size = slower/more granular sweep
TAPO_PATROL_SEGMENT_SIZE=0.08

# Small pause between patrol segments in seconds
TAPO_PATROL_STEP_PAUSE_SECS=0.2

# Manual touch duration in milliseconds (fallback when RelativeMove is not supported)
TAPO_TOUCH_MS=100

# Automatic stop for continuous movement if no new command arrives
TAPO_SAFETY_TIMEOUT_SECS=5

# --- Live view --------------------------------------------------------------
TAPO_RTSP_PORT=554
TAPO_STREAM_PATH=stream1
