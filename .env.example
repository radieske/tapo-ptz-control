# ─── Connection ───────────────────────────────────────────────────────────────
# Camera IP address on the local network
TAPO_IP=192.168.1.4

# ONVIF port (default for Tapo C500: 2020)
TAPO_PORT=2020

# ─── Authentication ───────────────────────────────────────────────────────────
# Camera Account username (Tapo app > Advanced Settings > Camera Account)
TAPO_USER=admin

# Camera Account password (required)
TAPO_PASS=your_password_here

# ─── Movement behavior ────────────────────────────────────────────────────────
# Short step intensity — w/a/s/d keys (0.0 to 1.0)
TAPO_STEP=0.1

# Continuous move speed — W/A/S/D keys (0.0 to 1.0)
TAPO_SPEED=0.5

# Manual touch duration in milliseconds (fallback when RelativeMove is not supported)
TAPO_TOUCH_MS=100

# Automatic stop for continuous movement if no new command arrives
TAPO_SAFETY_TIMEOUT_SECS=5
